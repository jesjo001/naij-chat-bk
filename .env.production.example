# =============================================================
# .env.production.example — Naija Sabi Chat API
# Copy to .env.production and fill in real values
# NEVER commit .env.production to git
# =============================================================

# ---- Server ----
NODE_ENV=production
PORT=5000

# Set to 1 if behind a reverse proxy (Nginx / cPanel proxy)
# Enables req.ip to return the real client IP instead of 127.0.0.1
TRUST_PROXY=1

# ---- MongoDB ----
# Atlas URI or self-hosted MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Connection pool — keep low on VPS with limited RAM
MONGO_POOL_MAX=20
MONGO_POOL_MIN=5

# ---- Redis ----
# redis:// for plain, rediss:// for TLS (Upstash / Redis Cloud)
REDIS_URL=redis://127.0.0.1:6379

# ---- Authentication ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=7d

# ---- OpenAI ----
OPENAI_API_KEY=sk-...

# ---- CORS ----
# Only accept requests from your frontend domain
CORS_ORIGIN=https://naijagbts.com

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Naija AI <noreply@naijagbts.com>"

# ---- Payment (Paystack or Flutterwave) ----
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...

# ---- PM2 Cluster ----
# 'max' uses all CPU cores; use a number like '2' on small VPS
PM2_INSTANCES=max
# Memory threshold before PM2 auto-restarts a worker
PM2_MAX_MEMORY=400M
# Number of cluster workers (overrides CPU auto-detect in cluster.ts)
# Set to 2 on a 2-core VPS, 4 on a 4-core VPS etc.
WORKER_COUNT=2

# ---- Security / Rate limiting ----
# Change these if you need different limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ---- Logging ----
LOG_LEVEL=error

# ---- Frontend URL (for email links, redirects) ----
CLIENT_URL=https://naijagbts.com
