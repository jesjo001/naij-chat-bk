NODE_ENV=development
PORT=5000

# ============================================
# Performance Configuration
# ============================================

# Redis Cache (Optional - system falls back to in-memory cache)
REDIS_URL=redis://localhost:6379

# Cluster Mode (Optional - defaults to CPU count - 1)
WORKER_COUNT=4

# Caching (Recommended: true for production)
ENABLE_CACHING=true
ENABLE_TEMPLATES=true
ENABLE_BATCH_PROCESSING=true

# ============================================
# Security Configuration
# ============================================

# CORS Origins (comma-separated list)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,https://yourdomain.com

# JWT Secret (REQUIRED - change in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Emails (comma-separated)
ADMIN_EMAILS=admin@example.com

# ============================================
# Database Configuration
# ============================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/naija-sabi-chat

# ============================================
# AI Configuration
# ============================================

# Groq API (Primary AI provider)
GROQ_API_KEY=your-groq-api-key
GROQ_COST_PER_1K_TOKENS=0.00059

# OpenAI API (Optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GBT_DEFAULT=false
OPENAI_GPT4_MINI_INPUT_COST=0.00015
OPENAI_GPT4_MINI_OUTPUT_COST=0.00060

# ============================================
# Payment Configuration (Flutterwave)
# ============================================

FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxx
# FLUTTERWAVE_WEBHOOK_SECRET=your_webhook_secret_hash (Optional)

# ============================================
# Email Configuration
# ============================================

# Mailbridge API (Primary)
API_MAIL_KEY=your-mailbridge-api-key

# Mail Server Settings (Fallback)
MAIL_HOST=premium216.web-hosting.com
MAIL_PORT=465
MAIL_SECURE=false
MAIL_USER=no-reply@naijagbts.com
MAIL_PASS="WX[XceX,r=AF"
MAIL_FROM=NaijaGBT <no-reply@naijagbt.com>

# Payment Alert Recipient
# Monitoring & Logging
# ============================================

LOG_LEVEL=info
API_TIMEOUT=30000
